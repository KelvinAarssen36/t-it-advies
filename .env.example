APP_NAME="@T IT Advies"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://t-it-advies.test

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=t_it_advies
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail verloopt altijd via de queue. Lokaal is 'database' prima,
# in productie draai je een queue worker (Horizon/Supervisor) of Laravel Cloud queues.
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- De website van de klant --------------------------------------------
# LET OP: er zijn twee e-mailadressen en ze doen iets anders.
#
#   info@atitadvies.nl     alles wat publiek is: de contactgegevens op de
#                          site, en waar het contactformulier naartoe gaat.
#   aarssen@atitadvies.nl  uitsluitend om in te loggen in het portaal.
#                          Staat bij PORTAL_ACCOUNT verderop.
#
# Welk adres waarvoor is staat uitgeschreven in config/site.php, en
# EmailAdressenTest valt om als ze door elkaar worden gehaald.
SITE_EMAIL="info@atitadvies.nl"
SITE_LINKEDIN=

# De tijdzone waarin een "dag" wordt geteld voor de bezoekcijfers. Niet
# hetzelfde als APP_TIMEZONE: die staat op UTC voor de tijdstempels in de
# database, maar een dagcijfer hoort te lopen van middernacht tot
# middernacht in de tijd van het bedrijf.
SITE_TIMEZONE="Europe/Amsterdam"

# Vertrouwde proxies, voor het echte IP-adres van een bezoeker.
#
# LEEG LATEN zolang er geen proxy voor de site staat -- dat is de veilige
# stand. Komt er een Cloudflare of loadbalancer voor, vul dan de adressen
# van die proxy in, gescheiden door komma's. Vul er nooit een sterretje in:
# de kop X-Forwarded-For is door de afzender zelf te verzinnen, en dan
# kiest iedereen zijn eigen IP-adres. Zie docs/operations/deployment.md.
TRUSTED_PROXIES=

# --- Mail ---------------------------------------------------------------
# Drie zinnige standen:
#
#   smtp    lokaal, naar MailHog of Mailpit. Je ziet de mail zoals hij
#           eruitziet, met opmaak en al, op http://localhost:8025.
#   log     lokaal zonder zo'n postbus: mail belandt als tekst in
#           storage/logs/laravel.log en er gaat niets de deur uit.
#   resend  productie.
#
# Alternatieven staan in docs/architecture/mail-en-queues.md
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025

# LET OP: mail uit de queue komt pas aan als er een worker draait. Zet
# `php artisan queue:work` ernaast; zonder worker blijft het bericht in de
# tabel `jobs` staan en lijkt het alsof er niets gebeurt. Alleen de
# verificatiemail gaat niet via de queue en komt dus altijd meteen.

# Laat deze twee leeg en ze vallen terug op SITE_EMAIL hierboven. Een eigen
# afzender invullen mag, maar gebruik dan een adres dat echt bestaat: op
# gedeelde hosting komt mail van een verzonnen no-reply eerder in de spam.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Waar berichten uit het contactformulier binnenkomen. Leeg betekent
# SITE_EMAIL, en dat is wat je wilt.
MAIL_CONTACT_ADDRESS=

RESEND_API_KEY=
# Ondertekeningsgeheim van de provider-webhook (begint met whsec_). Zonder
# deze waarde weigert de webhook-endpoint alle verzoeken.
MAIL_WEBHOOK_SECRET=

# Hoeveel dagen een regel in het mailoverzicht blijft staan. Opgeruimd door
# de geplande taak mail:prune-logs.
MAIL_LOG_RETENTION_DAYS=180

# --- Automatisch vertalen -----------------------------------------------
# De knop "Vertaal automatisch" in het portaal, via MyMemory. Er is geen
# sleutel en geen account nodig; dit werkt uit zichzelf.
#
# Op false verdwijnt de knop uit het scherm en werkt de rest van het
# portaal gewoon. Zie docs/architecture/automatisch-vertalen.md.
TRANSLATE_ENABLED=true

# Optioneel. Een adres hierin verhoogt het dagtegoed van 5.000 naar 50.000
# tekens. Het gaat als parameter mee; er hoort geen aanmelding bij.
TRANSLATE_EMAIL=

# --- Bot- en spambescherming -------------------------------------------
# Cloudflare Turnstile. Leeg laten schakelt de check uit in local/testing,
# maar in productie faalt de app bewust als deze ontbreekt.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Honeypot. HONEYPOT_SECONDS is het minimale aantal seconden dat een mens
# over een formulier zou doen; sneller ingezonden betekent bot.
HONEYPOT_ENABLED=true
HONEYPOT_SECONDS=2

# --- Beveiliging --------------------------------------------------------
# Hoe lang een 2FA-bevestiging voor gevoelige acties geldig blijft (seconden).
# Kort houden; dat is het hele punt van de check.
SENSITIVE_ACTION_TTL=900

# Tweestapsverificatie verplicht in het portaal: niemand komt erin voordat
# het is ingesteld. Laat je dit leeg, dan staat het in productie vanzelf aan
# en lokaal uit. Zie docs/security/authenticatie-en-2fa.md.
PORTAL_TWO_FACTOR_REQUIRED=true

# Het account van de eigenaar, aangemaakt door PortalAccountSeeder. Naam en
# adres hebben een standaardwaarde in config/security.php; het wachtwoord
# staat uitsluitend hier en nergens in git. Verplicht voordat je voor het
# eerst seedt op een nieuwe omgeving.
#
# Het adres is aarssen@atitadvies.nl en dat is ALLEEN om in te loggen. Het
# publieke adres is info@atitadvies.nl; zie SITE_EMAIL bovenaan.
PORTAL_ACCOUNT_EMAIL=
PORTAL_ACCOUNT_PASSWORD=

# De sleutel waarmee een passkey aan een account hangt. Laat je hem leeg,
# dan valt hij terug op APP_KEY -- dat werkt, en daarom is het een val:
# wordt APP_KEY ooit vernieuwd, dan zijn alle bestaande passkeys in een keer
# onbruikbaar en legt niets uit waarom.
#
# Zet in productie dus een eigen waarde, een keer, en laat hem staan:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#
# Passkeys werken alleen op https. Lokaal op een .test-adres verschijnt de
# knop niet; dat is de browser en niet de applicatie. Zie
# docs/operations/deployment.md.
PASSKEYS_USER_HANDLE_SECRET=

# Bewaartermijn van het beveiligingslogboek.
ACTIVITY_LOG_RETENTION_DAYS=365
SECURITY_LOG_RETENTION_DAYS=365
SECURITY_LOG_DAILY_DAYS=90

# Alarmering. Zonder adres blijft de applicatie stil; het logboek loopt wel
# gewoon door. Zie docs/operations/onderhoudstaken.md.
SECURITY_ALERT_ADDRESS=
SECURITY_ALERT_WINDOW_MINUTES=60
CRASH_ALERT_COOLDOWN_MINUTES=30
SECURITY_ALERT_COOLDOWN_MINUTES=180
SECURITY_ALERT_FAILED_LOGINS=25
SECURITY_ALERT_MAIL_PROBLEMS=5

# Beeld dat de klant uploadt. De standaardwaarden staan in config/media.php
# en zijn bewust krap: de browser verkleint een te groot beeld al vóór het
# versturen, en de grens moet ónder `upload_max_filesize` van PHP blijven.
# Verhoog je MEDIA_LOGO_MAX_KB, verhoog dan ook de PHP-instellingen op de
# server; zie docs/operations/deployment.md.
MEDIA_LOGO_MAX_KB=1536
MEDIA_LOGO_MIN_ZIJDE=48
MEDIA_LOGO_MAX_ZIJDE=3000

VITE_APP_NAME="${APP_NAME}"

