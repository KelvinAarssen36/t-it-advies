APP_NAME="@T IT Advies"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://t-it-advies.test

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=t_it_advies
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail verloopt altijd via de queue. Lokaal is 'database' prima,
# in productie draai je een queue worker (Horizon/Supervisor) of Laravel Cloud queues.
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---------------------------------------------------------------
# Lokaal: 'log' schrijft mail naar storage/logs. Productie: 'resend'.
# Alternatieven staan in docs/architecture/mail-en-queues.md
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@t-it-advies.nl"
MAIL_FROM_NAME="${APP_NAME}"

# Waar berichten uit het contactformulier binnenkomen. Los van het from-adres,
# zodat je verstuurt vanaf no-reply@ en ontvangt op een postbus die iemand leest.
MAIL_CONTACT_ADDRESS=

RESEND_API_KEY=
# Ondertekeningsgeheim van de provider-webhook (begint met whsec_). Zonder
# deze waarde weigert de webhook-endpoint alle verzoeken.
MAIL_WEBHOOK_SECRET=

# --- Bot- en spambescherming -------------------------------------------
# Cloudflare Turnstile. Leeg laten schakelt de check uit in local/testing,
# maar in productie faalt de app bewust als deze ontbreekt.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Honeypot. HONEYPOT_SECONDS is het minimale aantal seconden dat een mens
# over een formulier zou doen; sneller ingezonden betekent bot.
HONEYPOT_ENABLED=true
HONEYPOT_SECONDS=2

# --- Beveiliging --------------------------------------------------------
# Hoe lang een 2FA-bevestiging voor gevoelige acties geldig blijft (seconden).
# Kort houden; dat is het hele punt van de check.
SENSITIVE_ACTION_TTL=900

# Bewaartermijn van het beveiligingslogboek.
SECURITY_LOG_RETENTION_DAYS=365
SECURITY_LOG_DAILY_DAYS=90

VITE_APP_NAME="${APP_NAME}"
